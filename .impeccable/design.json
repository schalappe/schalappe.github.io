  "narrative": {
    "northStar": "The Field Notebook",
    "overview": "The site reads like an engineer's working record: off-white paper, dark ink, one typeface, and a left-hand margin where each section's name sits beside its evidence. Nothing is staged. The hierarchy comes from weight and size inside a single family, and sections are separated by hairline rules rather than cards or panels. A reader who wants depth gets long, calm prose; a reader who scans gets labels, dates, and stacks in muted ink.\n\nOne green carries every signal. It underlines links, fills the main action, rings keyboard focus, and draws the only ornament: a detection bounding box that locks onto the portrait with a confidence label (`ml_engineer 0.98`), a nod to the computer-vision work. That box is the notebook's one annotation in the margin; everything else stays plain.\n\nThe system is flat, light by default, and follows the reader's OS into a dark mode with the same structure. There is no JavaScript and only one animation.",
    "keyCharacteristics": [
      "Paper and ink, green only as signal.",
      "One family (Source Sans 3) with hierarchy by weight and size.",
      "Label column on the left, content on the right; one column on narrow screens.",
      "Hairline rules instead of surfaces; no shadows.",
      "One signature: the detector bounding box on the portrait."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Green means \"this is interactive or this is the annotation\". Never use it for decoration, section tints, or headings.",
        "section": "colors"
      },
      {
        "name": "The Two Greens Rule",
        "body": "Detection Green is for strokes and fills behind dark text; Annotation Ink is for green text and filled buttons. Never set text in Detection Green on paper.",
        "section": "colors"
      },
      {
        "name": "The Weight-Not-Font Rule",
        "body": "Hierarchy is built from 400, 600, and 700 in one family. Do not introduce a second typeface, italics for emphasis, or uppercase tracking.",
        "section": "typography"
      },
      {
        "name": "The Ruled Page Rule",
        "body": "Separate content with a 1px Ruled Line or with space, never with shadows, cards, or tinted panels.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep green to links, the primary action, focus rings, and the detector box.",
      "**Do** put new home sections in the label-column grid with a hairline top border.",
      "**Do** use Pencil Grey at 0.95rem for metadata (dates, places, stacks, captions).",
      "**Do** back every screenshot or diagram with the Plate White plate and Ruled Line border.",
      "**Do** gate any motion behind `prefers-reduced-motion: no-preference`, and keep the detector lock as the only one.",
      "**Do** define every new color for both light and dark modes."
    ],
    "donts": [
      "**Don't** add shadows, cards, gradients, or tinted section backgrounds.",
      "**Don't** add a second typeface or set text in Detection Green on paper.",
      "**Don't** add JavaScript-driven effects; the site ships none.",
      "**Don't** repeat the bounding-box motif elsewhere; it is the single annotation.",
      "**Don't** round corners past 6px."
    ]
  }
}
